CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 界面美化与基础运维
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_luci-app-diskman=y

# 网络加速与转发
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y

# 核心代理与 DNS
# passwall 与官方 openwrt-23.05 存在包冲突，已禁用
# CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

# 远程访问与 DDNS
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# 常用网络与系统工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y

# ===============================================================
# 精选实用插件（来自 openwrt-packages 仓库）
# ===============================================================

# 1. 文件管理 - 三选一
CONFIG_PACKAGE_luci-app-filebrowser=y        # 功能完整的文件管理器 ⭐ 推荐
# CONFIG_PACKAGE_luci-app-quickfile=y        # 轻量级快速文件传输
# CONFIG_PACKAGE_luci-app-fileassistant=y    # 高级文件编辑和管理

# 2. DNS 和广告屏蔽
CONFIG_PACKAGE_luci-app-adguardhome=y        # 广告屏蔽和域名过滤 ⭐ 推荐
CONFIG_PACKAGE_mosdns=y                       # MosDNS 核心库
CONFIG_PACKAGE_luci-app-mosdns=y              # MosDNS 可视化管理界面 ⭐ 推荐

# 3. 带宽限制和 QoS（质量保证）
CONFIG_PACKAGE_luci-app-eqos=y                # 按应用限速，支持 VLAN ⭐ 推荐

# 4. 网络助手工具
CONFIG_PACKAGE_luci-app-guest-wifi=y         # 访客网络管理
CONFIG_PACKAGE_luci-app-netwizard=y          # 网络诊断和配置向导

# 5. 系统监控和管理
CONFIG_PACKAGE_luci-app-quickstart=y         # 快速启动面板，一键启动常用服务

# 6. 主题美化（可选）
# CONFIG_PACKAGE_luci-theme-design=y         # Design 主题（轻量级）
# CONFIG_PACKAGE_luci-theme-material3=y      # Material3 主题（现代感）
# CONFIG_PACKAGE_luci-theme-glass=y          # Glass 主题（透明风格）

# 7. 其他有趣的工具
# CONFIG_PACKAGE_luci-app-subconverter=y     # 订阅转换工具（高级代理场景）
# CONFIG_PACKAGE_luci-app-wechatpush=y       # 系统通知推送至微信
# CONFIG_PACKAGE_luci-app-unblockneteasemusic=y  # 网易云音乐解锁

# 8. 配置管理
CONFIG_PACKAGE_luci-app-advanced=y           # 高级配置和优化建议

# 修复 dnsmasq 配置
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# 其他基础插件
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-app-store=y
