CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 界面美化与基础运维
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-poweroff=y
CONFIG_PACKAGE_luci-app-diskman=y

# 主题美化（推荐）
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-theme-material3=y
CONFIG_PACKAGE_luci-theme-glass=y
CONFIG_PACKAGE_luci-theme-alpha=y
CONFIG_PACKAGE_luci-theme-ifit=y
CONFIG_PACKAGE_luci-theme-tomato=y
CONFIG_PACKAGE_luci-theme-atmaterial_new=y

# 网络加速与转发
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y

# 核心代理与 DNS
# passwall 与官方 23.05 存在包冲突，已禁用
# CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y

# 远程访问与 DDNS
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# 常用网络与系统工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y

# ===============================================================
# 精选实用插件（来自 openwrt-packages 仓库）
# ===============================================================

# 1. 文件管理 - 三选一
CONFIG_PACKAGE_luci-app-filebrowser=y
# CONFIG_PACKAGE_luci-app-quickfile=y
# CONFIG_PACKAGE_luci-app-fileassistant=y

# 2. DNS 和广告屏蔽
CONFIG_PACKAGE_luci-app-adguardhome=y

# 3. 带宽限制和 QoS（质量保证）
CONFIG_PACKAGE_luci-app-eqos=y

# 4. 网络助手工具
CONFIG_PACKAGE_luci-app-guest-wifi=y
CONFIG_PACKAGE_luci-app-netwizard=y

# 5. 系统监控和管理
CONFIG_PACKAGE_luci-app-quickstart=y

# 6. 其他有趣的工具
# CONFIG_PACKAGE_luci-app-subconverter=y
# CONFIG_PACKAGE_luci-app-wechatpush=y
# CONFIG_PACKAGE_luci-app-unblockneteasemusic=y

# 8. 配置管理
CONFIG_PACKAGE_luci-app-advanced=y

# 修复 dnsmasq 配置
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# 其他基础插件
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-app-store=y
